{
  "name": "@fohte/vrt-report",
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/fohte/vrt-report.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vrt-report": "./bin/vrt-report.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "imports": {
    "#vrt-components/comparison-model": {
      "types": "./src/components/comparison-model.ts",
      "default": "./src/components/comparison-model.ts"
    },
    "#vrt-components/*": {
      "types": [
        "./src/components/*.tsx",
        "./src/components/*.ts"
      ],
      "default": "./src/components/*.tsx"
    },
    "#storybook.css": "./src/storybook.css",
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "git clean -fdX dist && tsc --project tsconfig.build.json && vite build",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit pnpm:test:browser",
    "test:type": "tsc --noEmit",
    "test:unit": "pnpm build && vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshot": "vitest run --config vitest.screenshot.config.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "neverthrow": "8.2.0",
    "pngjs": "7.0.0"
  },
  "peerDependencies": {
    "storybook": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.3.0",
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.1",
    "@fohte/storybook-addon": "0.2.0",
    "@fohte/ui": "0.1.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storycap-testrun/browser": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-storybook": "10.6.0",
    "knip": "6.37.0",
    "lucide-react": "0.577.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
    "shadcn": "4.21.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "version": "0.1.2"
}

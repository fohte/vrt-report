{
  "name": "@fohte/vrt-report",
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/fohte/vrt-report.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vrt-report": "./bin/vrt-report.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.0",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.5",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "knip": "6.36.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
